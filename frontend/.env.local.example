# =============================================================================
# AgentCare Frontend — Example Environment Configuration
#
# This file (.env.local.example) is SAFE TO COMMIT: placeholder/default
# values only, no real secrets. Copy it to `frontend/.env.local` for local
# development (Next.js loads `.env.local` automatically):
#   cp .env.local.example .env.local
#
# `.env.local` must NEVER be committed — see ../.gitignore and the repo
# root SECURITY.md.
#
# Both variables below already fall back to these exact values in
# `lib/config.ts` if unset, so the app runs without this file present.
# It exists to make the two variables discoverable and give you something
# to override (e.g. a backend running somewhere other than localhost:8000).
# =============================================================================

# Base URL of the AgentCare FastAPI backend, INCLUDING the /api/v1 prefix.
# This is a server-only variable (no NEXT_PUBLIC_ prefix): the browser never
# talks to the backend directly. Server Components and Server Actions call
# it directly; the few client-side calls (AI Assistant chat's streaming
# reveal, the practitioner available-times lookup, the workflow event SSE
# stream) go through the same-origin `/api/backend/*` proxy instead — see
# `app/api/backend/[...path]/route.ts`.
API_BASE_URL=http://localhost:8000/api/v1

# Name of the cookie the Next.js server uses to store the backend-issued
# JWT (httpOnly — never readable from client-side JavaScript; see
# `lib/session.ts`). Change only if it collides with another cookie in your
# deployment, or to run multiple AgentCare instances against one browser.
SESSION_COOKIE_NAME=agentcare_session

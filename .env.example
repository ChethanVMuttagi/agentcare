# =============================================================================
# AgentCare — Example Environment Configuration
#
# This file (.env.example) is SAFE TO COMMIT. It contains placeholder values
# only — no real secrets, keys, or credentials.
#
# Copy this file to `backend/.env` for local backend development (the
# backend reads .env relative to its own working directory):
#   cp .env.example backend/.env
#
# `.env` must NEVER be committed. It is excluded via .gitignore.
# See SECURITY.md for the full secret-management policy.
# =============================================================================

# --- Application ---------------------------------------------------------
APP_NAME=AgentCare
# One of: development | test | staging | production
# production must never also set DEBUG=true — the app will refuse to start.
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database --------------------------------------------------------------
# PostgreSQL is the production/system-of-record database, accessed via the
# async asyncpg driver (hence the postgresql+asyncpg:// scheme below).
# Local/dev placeholder only — never point this at a database containing
# real patient data. Use synthetic/anonymized data only. See SECURITY.md
# and docs/DATABASE.md. DATABASE_URL is optional: the app starts, and
# tests run, without it configured (see docs/DATABASE.md "Readiness").
DATABASE_URL=postgresql+asyncpg://agentcare_user:changeme@localhost:5432/agentcare_dev

# --- LLM Provider ------------------------------------------------------------
# Selects which provider the application's LLM abstraction layer targets.
# One of: groq | openai | anthropic
LLM_PROVIDER=groq
GROQ_API_KEY=changeme-groq-api-key
OPENAI_API_KEY=changeme-openai-api-key
ANTHROPIC_API_KEY=changeme-anthropic-api-key

# --- Auth / Secrets -------------------------------------------------------
# Generate a strong random value for local dev, e.g.:
#   openssl rand -hex 32
JWT_SECRET_KEY=changeme-generate-a-long-random-value

# --- Frontend ---------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# --- Document storage (STORY-008) --------------------------------------------
# "local" is the only backend implemented so far — a filesystem-backed store
# intended for LOCAL DEVELOPMENT ONLY (see docs/DOCUMENTS.md). The application
# refuses to start with APP_ENV=staging/production while this is "local" — a
# real object-storage backend must be configured (and implemented) first.
DOCUMENT_STORAGE_BACKEND=local
# Relative to the backend process's working directory; resolved to an absolute
# path at startup. Already covered by this repo's `local_storage/` .gitignore
# rule — never point this at a tracked source directory.
DOCUMENT_STORAGE_PATH=local_storage/documents
# Maximum accepted upload size, in bytes. 10 MB default.
DOCUMENT_MAX_UPLOAD_BYTES=10485760
